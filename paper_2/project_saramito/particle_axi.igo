
Mesh.CharacteristicLengthExtendFromBoundary = 0;

ox = 0;
oy = 0;
lx1 = lenc1;
lx2 = lenc2;
ly = radc;
rp[1] = radz;
rp[2] = radr;
xp[1] = 0;
yp[1] = 0;

// Create domain vertices
 
Point(1) = {ox+lx2, oy,    0.0, dx_box};
Point(2) = {ox+lx2, oy+ly,    0.0, dx_box};
Point(3) = {ox-lx1,    oy+ly, 0.0, dx_box};
Point(4) = {ox-lx1,    oy, 0.0, dx_box};
Point(5) = {xp[1]-rp[1],  oy,  0.0, dx_part};
Point(6) = {xp[1],  yp[1]+rp[2],  0.0, dx_part};
Point(7) = {xp[1]+rp[1],  oy,  0.0, dx_part};
Point(8) = {xp[1],  oy,  0.0, dx_part};
 
For i In {1:6}
  Physical Point(i) = i;
EndFor

// Create domain sides
 
Line(1) = {1, 2};
Line(2) = {2, 3};
Line(3) = {3, 4};
Line(4) = {4, 5};
Ellipse(5) = {5,8,6};
Ellipse(6) = {6,8,7};
Line(7) = {7, 1};

For i In {1:7}
  Physical Line(i) = i;
EndFor

Physical Line(8) = {5, 6};  // particle boundary
Physical Line(9) = {4, 7};  // symmetry line

// Make lines periodic

//Periodic Line {1} = {3} Translate{lenc1+lenc2,0,0};

// Create outer boundary

Line Loop(8) = { 1, 2, 3, 4, 5, 6, 7 };

// Create surface mesh (with holes)
 
Plane Surface(1) = {8};
 
Physical Surface(1) = {1};

// vim: set filetype=gmsh :  //
