// Make a mesh consisting of an box with spherical particles
// The full box, including the particles, is meshed.
// The space between the particles and the box is physical volume 1
// The space inside the particles is physical volume 2
//
// The input parameters are:
//
//   ox, oy, oz = the coordinates of the vertex with lower coordinates
//   lx, ly, lz = the lengths of the box along the x-, y-, z-directions
//   nobj = the number of spheres
//   xp(i,:), yp(i,:), zp(i,:) = the coordinates of the center of the sphere i
//   rp(i) = the radius of the sphere i
//   dx_box = the characteristic line element size on the box side
//   dx_part = the characteristic line element size on the sphere surface
//
// NOTE: the parameters have to be defined before including this file.
//
// Points and surfaces are numbered as follows:
//
// P1 = (ox,    oy,    oz)
// P2 = (ox+lx, oy,    oz   )
// P3 = (ox+lx, oy,    oz+lz)
// P4 = (ox,    oy,    oz+lz)
// P5 = (ox,    oy+ly, oz,  )
// P6 = (ox+lx, oy+ly, oz,  )
// P7 = (ox+lx, oy+ly, oz+lz)
// P8 = (ox,    oy+ly, oz+lz)
// S1 = P1-P2-P3-P4  ( parallel to xz passing through oy )
// S2 = P2-P3-P7-P6  ( parallel to yz passing through ox+lx )
// S3 = P6-P5-P8-P7  ( parallel to xz passing through oy+ly )
// S4 = P4-P1-P5-P8  ( parallel to yz passing through ox )
// S5 = P3-P4-P8-P7  ( parallel to xy passing through oz+lz )
// S6 = P1-P2-P6-P5  ( parallel to xy passing through oz )


// External domain

Point(1) = {ox,    oy,    oz,    dx_box};
Point(2) = {ox+lx, oy,    oz,    dx_box};
Point(3) = {ox+lx, oy,    oz+lz, dx_box};
Point(4) = {ox,    oy,    oz+lz, dx_box};
Point(5) = {ox,    oy+ly, oz,    dx_box};
Point(6) = {ox+lx, oy+ly, oz,    dx_box};
Point(7) = {ox+lx, oy+ly, oz+lz, dx_box};
Point(8) = {ox,    oy+ly, oz+lz, dx_box};

For i In {1:8}
  Physical Point(i) = i;
EndFor

Line(1) = {1, 2};
Line(2) = {2, 3};
Line(3) = {3, 4};
Line(4) = {4, 1};
Line(5) = {3, 7};
Line(6) = {7, 6};
Line(7) = {6, 2};
Line(8) = {1, 5};
Line(9) = {5, 8};
Line(10) = {8, 4};
Line(11) = {8, 7};
Line(12) = {6, 5};

Line Loop(1) = {-1,-4,-3,-2};
Line Loop(2) = {2, 5, 6, 7};
Line Loop(3) = {12, 9, 11, 6};
Line Loop(4) = {-4,-10,-9,-8};
Line Loop(5) = {-3,5,-11,10};
Line Loop(6) = {1, -7, 12, -8};

For i In {1:6}
  Plane Surface(i) = {i};
  Physical Surface(i) = i;
EndFor

// Make mesh surfaces periodic

//Periodic Surface {3} = {1} Translate{0,ly,0};

surf_loop[0] = newsl;

Surface Loop(surf_loop[0]) = {1, 2, 3, 4, 5, 6};


// Sphere

Function MakeSphere 

  p1 = newp; Point(p1) = {x,   y,   z,   dx_part} ;
  p2 = newp; Point(p2) = {x+r, y,   z,   dx_part} ;
  p3 = newp; Point(p3) = {x,   y+r, z,   dx_part} ;
  p4 = newp; Point(p4) = {x,   y,   z+r, dx_part} ;
  p5 = newp; Point(p5) = {x-r, y,   z,   dx_part} ;
  p6 = newp; Point(p6) = {x,   y-r, z,   dx_part} ;
  p7 = newp; Point(p7) = {x,   y,   z-r, dx_part} ;

  c1 = newl; Circle(c1) = {p2, p1, p7};
  c2 = newl; Circle(c2) = {p7, p1, p5};
  c3 = newl; Circle(c3) = {p5, p1, p4};
  c4 = newl; Circle(c4) = {p4, p1, p2};
  c5 = newl; Circle(c5) = {p2, p1, p3};
  c6 = newl; Circle(c6) = {p3, p1, p5};
  c7 = newl; Circle(c7) = {p5, p1, p6};
  c8 = newl; Circle(c8) = {p6, p1, p2};
  c9 = newl; Circle(c9) = {p7, p1, p3};
  c10 = newl; Circle(c10) = {p3, p1, p4};
  c11 = newl; Circle(c11) = {p4, p1, p6};
  c12 = newl; Circle(c12) = {p6, p1, p7};

  // Spherical surface

  lin1 = newll; Line Loop(lin1) = {c5, c10, c4};     surf1 = news; Ruled Surface(surf1) = {lin1};
  lin2 = newll; Line Loop(lin2) = {c9, -c5, c1};     surf2 = news; Ruled Surface(surf2) = {lin2};
  lin3 = newll; Line Loop(lin3) = {c12, -c8, -c1};   surf3 = news; Ruled Surface(surf3) = {lin3};
  lin4 = newll; Line Loop(lin4) = {c8, -c4, c11};    surf4 = news; Ruled Surface(surf4) = {lin4};
  lin5 = newll; Line Loop(lin5) = {-c10, c6, c3};    surf5 = news; Ruled Surface(surf5) = {lin5};
  lin6 = newll; Line Loop(lin6) = {-c11, -c3, c7};   surf6 = news; Ruled Surface(surf6) = {lin6};
  lin7 = newll; Line Loop(lin7) = {-c2, -c7, -c12};  surf7 = news; Ruled Surface(surf7) = {lin7};
  lin8 = newll; Line Loop(lin8) = {-c6, -c9, c2};    surf8 = news; Ruled Surface(surf8) = {lin8};

  surf_loop[t] = newsl;

  Surface Loop(surf_loop[t]) = {surf8, surf5, surf1, surf2, surf3, surf7, surf6, surf4};

  Physical Surface(t+6) = {surf8, surf5, surf1, surf2, surf3, surf7, surf6, surf4};
  
Return


// Make nobj spheres

For t In {1:nobj}

  x = xp[t];
  y = yp[t];
  z = zp[t];
  r = rp[t]; 

  Call MakeSphere;

EndFor


// Make box with holes (=the spheres)

Volume(1) = {surf_loop[]} ;

Physical Volume(1) = {1};

For t In {1:nobj}

  Volume(t+1) = {surf_loop[t]};

EndFor
 
Physical Volume(2) = {2:nobj+1};


// vim: set filetype=gmsh :  //
